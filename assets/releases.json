    "version": "3.2.1",
    "title": "v3.2.1",
    "date": "2026-10-12",
    "github": "https://github.com/SSSherlocked/pure_live/releases/tag/v3.2.1",
    "author": {
      "name": "github-actions[bot]",
      "avatar": "https://avatars.githubusercontent.com/in/15368?v=4",
      "profile": "https://github.com/apps/github-actions"
